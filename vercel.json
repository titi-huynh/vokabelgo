{
  "git": {
    "deploymentEnabled": {
      "codex/kino-dungeon-missing-lines": false,
      "codex/kino-frieren-missing-lines": false,
      "codex/kino-spongebob-pizza-missing-lines": false,
      "codex/kino-spongebob-blubberunterricht-missing-lines": false,
      "codex/kino-druck-s07e01-missing-lines": false
    }
  },
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        }
      ]
    },
    {
      "source": "/(video|music)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ],
  "redirects": [
    {
      "destination": "https://github.com/titi-huynh/vokabelgo-media/releases/download/media-v1/video--kino-light--:file",
      "permanent": false,
      "source": "/video/kino-light/:file"
    },
    {
      "destination": "https://github.com/titi-huynh/vokabelgo-media/releases/download/media-v1/video--:file",
      "permanent": false,
      "source": "/video/:file"
    },
    {
      "destination": "https://github.com/titi-huynh/vokabelgo-media/releases/download/media-v1/music--:file",
      "permanent": false,
      "source": "/music/:file"
    },
    {
      "destination": "https://github.com/titi-huynh/vokabelgo-media/releases/download/media-v1/assets--vocab-audio--:file",
      "permanent": false,
      "source": "/assets/vocab-audio/:file"
    },
    {
