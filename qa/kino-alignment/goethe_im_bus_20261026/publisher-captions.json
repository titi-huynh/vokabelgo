[
  {
    "index": 1,
    "start": 4.76,
    "end": 6.201,
    "text": "Ich heiße Nevin."
  },
  {
    "index": 2,
    "start": 9.845,
    "end": 10.765,
    "text": "Kenne ich Sie?"
  },
  {
    "index": 3,
    "start": 10.765,
    "end": 13.714,
    "text": "Nein. Ich bin neu hier."
  },
  {
    "index": 4,
    "start": 17.722,
    "end": 21.692,
    "text": "Junge Frau! Sie müssen hier aussteigen."
  },
  {
    "index": 5,
    "start": 70.601,
    "end": 75.681,
    "text": "Entschuldigung, bin ich hier richtig?"
  },
  {
    "index": 6,
    "start": 76.716,
    "end": 78.516,
    "text": "Das kommt darauf an."
  },
  {
    "index": 7,
    "start": 79.753,
    "end": 82.483,
    "text": "Ich weiß ja nicht, wo Sie hin wollen."
  },
  {
    "index": 8,
    "start": 83.782,
    "end": 86.762,
    "text": "Wohin wollen Sie denn?"
  },
  {
    "index": 9,
    "start": 87.782,
    "end": 89.212,
    "text": "Ähm ..."
  },
  {
    "index": 10,
    "start": 92.747,
    "end": 98.247,
    "text": "Agentur für Arbeit."
  },
  {
    "index": 11,
    "start": 98.247,
    "end": 100.753,
    "text": "Ach, zum Arbeitsamt wollen Sie!"
  },
  {
    "index": 12,
    "start": 100.753,
    "end": 103.729,
    "text": "Ja, da sind Sie hier schon richtig."
  },
  {
    "index": 13,
    "start": 105.516,
    "end": 108.516,
    "text": "Ah, da kommt er."
  },
  {
    "index": 14,
    "start": 109.471,
    "end": 111.161,
    "text": "Ist das mein Bus?"
  },
  {
    "index": 15,
    "start": 111.161,
    "end": 112.225,
    "text": "Ja ja ..."
  },
  {
    "index": 16,
    "start": 125.493,
    "end": 129.783,
    "text": "Ich möchte zur Agentur für Arbeit."
  },
  {
    "index": 17,
    "start": 129.783,
    "end": 132.001,
    "text": "Haben Sie eine Fahrkarte?"
  },
  {
    "index": 18,
    "start": 133.431,
    "end": 134.531,
    "text": "Nein."
  },
  {
    "index": 19,
    "start": 136.217,
    "end": 137.767,
    "text": "Noch nicht."
  },
  {
    "index": 20,
    "start": 137.917,
    "end": 142.377,
    "text": "Das Ticket müssen Sie am Automaten kaufen."
  },
  {
    "index": 21,
    "start": 170.315,
    "end": 172.573,
    "text": "Auf die Eins drücken!"
  },
  {
    "index": 22,
    "start": 173.24,
    "end": 175.558,
    "text": "Nummer eins!"
  },
  {
    "index": 23,
    "start": 179.781,
    "end": 183.251,
    "text": "Er meint die Eins beim Automaten."
  },
  {
    "index": 24,
    "start": 184.501,
    "end": 185.731,
    "text": "Danke."
  },
  {
    "index": 25,
    "start": 193.739,
    "end": 198.049,
    "text": "Warten Sie, Sie brauchen Kleingeld."
  },
  {
    "index": 26,
    "start": 200.535,
    "end": 204.265,
    "text": "... zwei, vier, fünf."
  },
  {
    "index": 27,
    "start": 206.494,
    "end": 207.434,
    "text": "Vielen Dank!"
  },
  {
    "index": 28,
    "start": 207.434,
    "end": 208.492,
    "text": "Gerne."
  },
  {
    "index": 29,
    "start": 235.735,
    "end": 238.171,
    "text": "Einen schönen Tag noch, Wiedersehen!"
  },
  {
    "index": 30,
    "start": 238.171,
    "end": 240.506,
    "text": "Auf Wiedersehen!"
  },
  {
    "index": 31,
    "start": 246.753,
    "end": 249.682,
    "text": "Kann ich mich bitte setzen?"
  },
  {
    "index": 32,
    "start": 250.504,
    "end": 252.844,
    "text": "Schauen Sie, der Platz ist für Alte"
  },
  {
    "index": 33,
    "start": 252.844,
    "end": 254.5,
    "text": "und Kranke."
  },
  {
    "index": 34,
    "start": 256.81,
    "end": 258.221,
    "text": "Ah!"
  },
  {
    "index": 35,
    "start": 384.487,
    "end": 385.989,
    "text": "Junge Frau!"
  },
  {
    "index": 36,
