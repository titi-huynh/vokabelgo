[
  {
    "officialId": 1,
    "start": 1.52,
    "end": 5.48,
    "text": "♪ Ja, hier kommt Conni, meine Freundin Conni,"
  },
  {
    "officialId": 2,
    "start": 6.84,
    "end": 9.88,
    "text": "bei ihr ist jeden Tag etwas los."
  },
  {
    "officialId": 3,
    "start": 11.64,
    "end": 16.16,
    "text": "Schwimmen oder zelten gehen, reiten, tanzen, Uhr verstehen,"
  },
  {
    "officialId": 4,
    "start": 16.36,
    "end": 19.28,
    "text": "Pizza backen macht ihr Riesenspaß."
  },
  {
    "officialId": 5,
    "start": 20.84,
    "end": 23.96,
    "text": "Bei Conni da passiert immer was."
  },
  {
    "officialId": 6,
    "start": 24.88,
    "end": 28.92,
    "text": "Ja, hier kommt Conni, alle lieben Conni"
  },
  {
    "officialId": 7,
    "start": 30.44,
    "end": 33.48,
    "text": "Jeder neue Tag macht sie groß."
  },
  {
    "officialId": 8,
    "start": 34.2,
    "end": 35.68,
    "text": "Ja, hier kommt Conni ♪"
  },
  {
    "officialId": 9,
    "start": 40.76,
    "end": 42.24,
    "text": "* fröhliche Musik *"
  },
  {
    "officialId": 10,
    "start": 45.4,
    "end": 48.12,
    "text": "Komm, Mau, wir gucken mal, was Papa macht."
  },
  {
    "officialId": 11,
    "start": 48.2,
    "end": 49.68,
    "text": "Siehst du, da ist er."
  },
  {
    "officialId": 12,
    "start": 51.12,
    "end": 53.24,
    "text": "Hey, Mau, wo willst du denn hin?"
  },
  {
    "officialId": 13,
    "start": 55.28,
    "end": 56.76,
    "text": "Hä?"
  },
  {
    "officialId": 14,
    "start": 60.24,
    "end": 62.32,
    "text": "Papa? - Ja, Conni?"
  },
  {
    "officialId": 15,
    "start": 62.6,
    "end": 64.08,
    "text": "Was ist das?"
  },
  {
    "officialId": 16,
    "start": 64.44,
    "end": 67.84,
    "text": "Das sind Blumensamen. - Boah, sind die alle für uns?"
  },
  {
    "officialId": 17,
    "start": 68.44,
    "end": 70.48,
    "text": "Ja, die wollte ich noch einpflanzen,"
  },
  {
    "officialId": 18,
    "start": 70.56,
    "end": 72.4,
    "text": "wenn ich mit dem Mähen fertig bin."
  },
  {
    "officialId": 19,
    "start": 72.48,
    "end": 75.12,
    "text": "Oh, kann ich dir helfen? - Ja, klar."
  },
  {
    "officialId": 20,
    "start": 75.48,
    "end": 79.88,
    "text": "Wenn du magst, kannst du die Pflanzen schon mal zu dem Beet tragen."
  },
  {
    "officialId": 21,
    "start": 80.84,
    "end": 82.92,
    "text": "Aber nicht alle Blumen abmähen."
  },
  {
    "officialId": 22,
    "start": 83.2,
    "end": 84.72,
    "text": "Die sind doch so schön."
  },
  {
    "officialId": 23,
    "start": 85.16,
    "end": 87.03999999999999,
    "text": "Ja ja, ich mäh drumherum."
  },
  {
    "officialId": 24,
    "start": 90.16,
    "end": 91.64,
    "text": "M-hm, danke."
  },
  {
    "officialId": 25,
    "start": 92.16,
    "end": 93.64,
    "text": "* Lachen *"
  },
  {
    "officialId": 26,
    "start": 94.56,
    "end": 96.03999999999999,
    "text": "* harmonische Musik *"
  },
  {
    "officialId": 27,
    "start": 97.64,
    "end": 99.12,
    "text": "So..."
  },
  {
    "officialId": 28,
    "start": 99.44,
    "end": 101.72,
    "text": "Hä? Was machst du damit?"
  },
  {
    "officialId": 29,
    "start": 102.88,
    "end": 104.6,
    "text": "Das kommt auf den Kompost."
  },
  {
    "officialId": 30,
    "start": 105.0,
    "end": 107.75999999999999,
    "text": "Da bring ich für Mama den Abfall aus der Küche hin."
  },
  {
    "officialId": 31,
    "start": 107.84,
    "end": 109.44,
    "text": "Ich will das machen, ja?"
  },
  {
    "officialId": 32,
    "start": 114.24000000000001,
    "end": 116.92,
    "text": "Die Gurkenschalen und die schrumpeligen Kartoffeln,"
  },
  {
    "officialId": 33,
    "start": 117.0,
    "end": 119.12,
    "text": "die hab ich reingeworfen. - M-hm,"
  },
  {
    "officialId": 34,
    "start": 119.52000000000001,
    "end": 123.56,
    "text": "und wenn das alles verrottet, wird daraus richtig gute Gartenerde."
  },
  {
    "officialId": 35,
    "start": 124.76,
    "end": 128.16,
    "text": "Komm mit, Conni, holen wir die Gartengeräte. - Toll."
  },
  {
    "officialId": 36,
    "start": 128.28,
    "end": 129.76,
    "text": "So, lass mal sehen."
  },
  {
    "officialId": 37,
    "start": 130.52,
    "end": 132.0,
    "text": "Ah, ja, da ist er ja."
  },
  {
    "officialId": 38,
    "start": 132.48,
    "end": 135.0,
    "text": "Zum Pflanzen brauchen wir einen Spaten."
  },
  {
    "officialId": 39,
    "start": 135.52,
    "end": 137.72,
    "text": "Huh, der ist aber richtig schwer."
  },
  {
    "officialId": 40,
    "start": 138.16,
    "end": 141.84,
    "text": "Den leg ich hier rein. - Ja, damit grab ich die Erde um."
  },
  {
    "officialId": 41,
    "start": 142.44,
    "end": 146.44,
    "text": "Und der hier ist für dich. Und noch eine Hacke."
  },
  {
    "officialId": 42,
    "start": 147.07999999999998,
    "end": 148.56,
    "text": "Wozu brauchen wir die?"
  },
  {
    "officialId": 43,
    "start": 151.8,
    "end": 153.88,
    "text": "Damit lockern wir die Erde auf."
  },
  {
    "officialId": 44,
    "start": 154.36,
    "end": 155.84,
    "text": "So..."
  },
  {
    "officialId": 45,
    "start": 156.0,
    "end": 158.4,
    "text": "hier noch ein Eimer für das Unkraut."
  },
  {
    "officialId": 46,
    "start": 158.56,
    "end": 161.32,
    "text": "2 Töpfe... Ach ja, und für alle Fälle"
  },
  {
    "officialId": 47,
    "start": 161.4,
    "end": 164.12,
    "text": "können wir ja noch die Gartenschere mitnehmen."
  },
  {
    "officialId": 48,
    "start": 164.2,
    "end": 165.68,
    "text": "Das sollte alles sein."
  },
  {
    "officialId": 49,
    "start": 165.88,
    "end": 167.88,
    "text": "Dann fangen wir mal an. - M-hm."
  },
  {
    "officialId": 50,
    "start": 168.84,
    "end": 170.32,
    "text": "* harmonische Musik *"
  },
  {
    "officialId": 51,
    "start": 175.72,
    "end": 177.2,
    "text": "Hm."
  },
  {
    "officialId": 52,
    "start": 178.36,
    "end": 179.84,
    "text": "Was ist denn, Papa?"
  },
  {
    "officialId": 53,
    "start": 181.04,
    "end": 184.0,
    "text": "Ich überlege, wo welche Pflanze am besten hinkommt."
  },
  {
    "officialId": 54,
    "start": 184.08,
    "end": 186.48,
    "text": "Weißt du, die Tomaten werden so hoch,"
  },
  {
    "officialId": 55,
    "start": 186.56,
    "end": 190.08,
    "text": "und der Salat und die anderen Pflanzen sind viel kleiner."
  },
  {
    "officialId": 56,
    "start": 190.16,
    "end": 191.64,
    "text": "Ja und?"
  },
  {
    "officialId": 57,
    "start": 192.48,
    "end": 196.12,
    "text": "Na ja, die wollen alle viel Sonne, damit sie schön wachsen können."
  },
  {
    "officialId": 58,
    "start": 196.2,
    "end": 199.4,
    "text": "Ähm... (lacht) ich will auch in der Sonne stehen."
  },
  {
    "officialId": 59,
    "start": 201.0,
    "end": 203.4,
    "text": "Ja, du kannst dich bewegen,"
  },
  {
    "officialId": 60,
    "start": 204.0,
    "end": 206.76,
    "text": "aber die Pflanzen müssen wir alle so anordnen,"
  },
  {
    "officialId": 61,
    "start": 206.84,
    "end": 208.84,
    "text": "dass sie Sonne bekommen. - Aha."
  },
  {
    "officialId": 62,
    "start": 209.88,
    "end": 211.36,
    "text": "Hm..."
  },
  {
    "officialId": 63,
    "start": 212.76,
    "end": 215.12,
    "text": "Ich hol noch schnell ein paar Pflanzstöcke."
  },
  {
    "officialId": 64,
    "start": 215.2,
    "end": 217.76,
    "text": "Tomaten brauchen nämlich eine Kletterhilfe,"
  },
  {
    "officialId": 65,
    "start": 217.84,
    "end": 222.04,
    "text": "sonst kippen sie später um. Hackst du schon mal das Unkraut raus?"
  },
  {
    "officialId": 66,
    "start": 222.12,
    "end": 224.04,
    "text": "Hm? Was ist denn Unkraut?"
  },
  {
    "officialId": 67,
    "start": 224.56,
    "end": 227.0,
    "text": "Na, all das Grünzeug, was du hier siehst."
  },
  {
    "officialId": 68,
    "start": 227.07999999999998,
    "end": 229.8,
    "text": "Das haben wir nämlich gar nicht gepflanzt."
  },
  {
    "officialId": 69,
    "start": 230.8,
    "end": 232.28,
    "text": "Hm."
  },
  {
    "officialId": 70,
    "start": 235.07999999999998,
    "end": 237.4,
    "text": "* Maunzen, Lachen *"
  },
  {
    "officialId": 71,
    "start": 242.84,
    "end": 245.76,
    "text": "He, Mau, Vorsicht, ich muss doch hier hacken."
  },
  {
    "officialId": 72,
    "start": 251.88,
    "end": 254.36,
    "text": "Ui, das ist ja 'ne echt dicke Wurzel."
  },
  {
    "officialId": 73,
    "start": 254.96,
    "end": 256.44,
    "text": "So."
  },
  {
    "officialId": 74,
    "start": 258.24,
    "end": 259.72,
    "text": "Hm?"
  },
  {
    "officialId": 75,
    "start": 260.44,
    "end": 261.96,
    "text": "Huch, wer bist du denn?"
  },
  {
    "officialId": 76,
    "start": 263.0,
    "end": 265.4,
    "text": "Na, habt ihr was Spannendes entdeckt?"
  },
  {
    "officialId": 77,
    "start": 265.48,
    "end": 267.4,
    "text": "Guck mal. - Oh, ein Regenwurm."
  },
  {
    "officialId": 78,
    "start": 267.92,
    "end": 269.44,
    "text": "Die sind sehr nützlich."
  },
  {
    "officialId": 79,
    "start": 270.52,
    "end": 272.72,
    "text": "(lacht) Der kribbelt in der Hand."
  },
  {
    "officialId": 80,
    "start": 273.15999999999997,
    "end": 275.24,
    "text": "Ja, weil er sich so schlängelt."
  },
  {
    "officialId": 81,
    "start": 275.8,
    "end": 278.48,
    "text": "Und genau so buddeln die sich auch durch die Beete"
  },
  {
    "officialId": 82,
    "start": 278.56,
    "end": 280.68,
    "text": "und helfen, die Erde umzugraben."
  },
  {
    "officialId": 83,
    "start": 282.6,
    "end": 284.08,
    "text": "So ungefähr."
  },
  {
    "officialId": 84,
    "start": 284.24,
    "end": 287.32,
    "text": "Die tiefere Erdschicht kommt dadurch nach oben."
  },
  {
    "officialId": 85,
    "start": 289.28,
    "end": 293.48,
    "text": "Dann buddel schnell weiter, aber besser nicht da, wo Papa gräbt."
  },
  {
    "officialId": 86,
    "start": 302.08,
    "end": 305.0,
    "text": "Ach, sieh mal, da habe ich Unkraut vergessen."
  },
  {
    "officialId": 87,
    "start": 305.72,
    "end": 309.64,
    "text": "Ach das, nein, das sind Sonnenblumen. Die lassen wir stehen."
  },
  {
    "officialId": 88,
    "start": 309.88,
    "end": 312.36,
    "text": "Die haben doch so wunderschöne Blüten."
  },
  {
    "officialId": 89,
    "start": 312.56,
    "end": 314.84,
    "text": "Dann haben wir doch was gepflanzt?"
  },
  {
    "officialId": 90,
    "start": 315.08,
    "end": 316.56,
    "text": "Nicht ganz,"
  },
  {
    "officialId": 91,
    "start": 316.64,
    "end": 320.0,
    "text": "den Samen hat ein Vogel verloren oder vielleicht eine Maus."
  },
  {
    "officialId": 92,
    "start": 320.08,
    "end": 323.36,
    "text": "Wie das denn? - Na ja, manche Tiere sammeln Samen,"
  },
  {
    "officialId": 93,
    "start": 323.44,
    "end": 326.76,
    "text": "um sie zu fressen. - Eichhörnchen sammeln doch Nüsse. - Genau,"
  },
  {
    "officialId": 94,
    "start": 326.84,
    "end": 330.28,
    "text": "und manchmal vergessen sie dann, wo sie die vergraben haben."
  },
  {
    "officialId": 95,
    "start": 330.36,
    "end": 332.2,
    "text": "Da wächst dann ein Nussbaum."
  },
  {
    "officialId": 96,
    "start": 332.4,
    "end": 334.88,
    "text": "Vögel verlieren auch mal ein Korn oder..."
  },
  {
    "officialId": 97,
    "start": 334.96,
    "end": 337.36,
    "text": "der Wind weht die Samen überall hin."
  },
  {
    "officialId": 98,
    "start": 342.12,
    "end": 343.6,
    "text": "* harmonische Musik *"
  },
  {
    "officialId": 99,
    "start": 344.6,
    "end": 346.64,
    "text": "So? - Ja, genau, Conni."
  },
  {
    "officialId": 100,
    "start": 346.96,
    "end": 349.24,
    "text": "Jetzt wachsen überall Pusteblumen."
  },
  {
    "officialId": 101,
    "start": 352.68,
    "end": 354.15999999999997,
    "text": "* Maunzen *"
  },
  {
    "officialId": 102,
    "start": 357.56,
    "end": 361.16,
    "text": "Ich denke, hier ist der richtige Platz für die Tomaten."
  },
  {
    "officialId": 103,
    "start": 361.96,
    "end": 365.24,
    "text": "Hm, Tomaten mag ich am liebsten."
  },
  {
    "officialId": 104,
    "start": 366.84,
    "end": 369.76,
    "text": "Hm, die riechen jetzt schon nach Tomaten. Hä?"
  },
  {
    "officialId": 105,
    "start": 369.96,
    "end": 374.44,
    "text": "Aber da sind doch noch gar keine dran. - Lass mich auch mal riechen."
  },
  {
    "officialId": 106,
    "start": 376.0,
    "end": 377.68,
    "text": "Ja. Stimmt."
  },
  {
    "officialId": 107,
    "start": 377.88,
    "end": 380.52,
    "text": "Da riechen die Blätter wie später die Früchte."
  },
  {
    "officialId": 108,
    "start": 380.6,
    "end": 383.68,
    "text": "Hier, aus den Blüten werden später die Tomaten."
  },
  {
    "officialId": 109,
    "start": 384.24,
    "end": 388.2,
    "text": "Oh, das ist toll. So, und jetzt kommst du in die Erde."
  },
  {
    "officialId": 110,
    "start": 389.8,
    "end": 391.28,
    "text": "Die klemmt irgendwie."
  },
  {
    "officialId": 111,
    "start": 391.88,
    "end": 394.84000000000003,
    "text": "Die haben wahrscheinlich schon richtig kräftige Wurzeln."
  },
  {
    "officialId": 112,
    "start": 394.92,
    "end": 399.12,
    "text": "Am besten, du drückst den Topf an allen Seiten ein bisschen ein."
  },
  {
    "officialId": 113,
    "start": 400.44,
    "end": 401.92,
    "text": "Vielleicht so?"
  },
  {
    "officialId": 114,
    "start": 402.56,
    "end": 404.04,
    "text": "Haha."
  },
  {
    "officialId": 115,
    "start": 404.48,
    "end": 405.96,
    "text": "Ich hab sie."
  },
  {
    "officialId": 116,
    "start": 407.28,
    "end": 411.4,
    "text": "Gut. Du hast die Wurzeln im Topf ein bisschen zusammengedrückt,"
  },
  {
    "officialId": 117,
    "start": 411.56,
    "end": 415.68,
    "text": "jetzt musst du sie lockern, damit sie sich gut entwickeln kann."
  },
  {
    "officialId": 118,
    "start": 417.88,
    "end": 419.36,
    "text": "So. - Prima."
  },
  {
    "officialId": 119,
    "start": 419.6,
    "end": 422.2,
    "text": "Mit den Wurzeln hält die Pflanze sich fest."
  },
  {
    "officialId": 120,
    "start": 422.28,
    "end": 427.12,
    "text": "Die Wurzel saugt auch Wasser aus der Erde, damit die Pflanze trinken kann."
  },
  {
    "officialId": 121,
    "start": 427.2,
    "end": 430.88,
    "text": "Und damit helfen wir ihr, dass sie später nicht umkippen kann."
  },
  {
    "officialId": 122,
    "start": 430.96,
    "end": 432.44,
    "text": "Richtig, ganz genau."
  },
  {
    "officialId": 123,
    "start": 433.24,
    "end": 436.64,
    "text": "Nun musst du die Pflanze noch mit diesen Bändchen festbinden,"
  },
  {
    "officialId": 124,
    "start": 436.72,
    "end": 439.6,
    "text": "damit sie auch einen guten Halt hat. - Okay."
  },
  {
    "officialId": 125,
    "start": 443.72,
    "end": 446.32,
    "text": "Prima, jetzt kommen die Radieschensamen."
  },
  {
    "officialId": 126,
    "start": 446.48,
    "end": 448.28,
    "text": "Halt mal die Hand auf. - Ja."
  },
  {
    "officialId": 127,
    "start": 450.16,
    "end": 451.8,
    "text": "Oh, so klein?"
  },
  {
    "officialId": 128,
    "start": 452.2,
    "end": 454.68,
    "text": "Und daraus werden richtige Radieschen?"
  },
  {
    "officialId": 129,
    "start": 455.32,
    "end": 457.8,
    "text": "Ja, viele Pflanzensamen sind so klein,"
  },
  {
    "officialId": 130,
    "start": 458.4,
    "end": 462.15999999999997,
    "text": "und trotzdem stecken in diesen Körnchen alle Informationen,"
  },
  {
    "officialId": 131,
    "start": 462.24,
    "end": 465.76,
    "text": "wann sie was und vor allem, was sie mal werden sollen."
  },
  {
    "officialId": 132,
    "start": 465.88,
    "end": 467.36,
    "text": "Aha."
  },
  {
    "officialId": 133,
    "start": 473.96,
    "end": 475.68,
    "text": "So, dann wachst mal schön."
  },
  {
    "officialId": 134,
    "start": 477.0,
    "end": 479.48,
    "text": "Das tun sie bestimmt, wenn wir sie gut gießen."
  },
  {
    "officialId": 135,
    "start": 479.56,
    "end": 481.16,
    "text": "Ich hole eine Gießkanne."
  },
  {
    "officialId": 136,
    "start": 487.48,
    "end": 488.96,
    "text": "Hä? Hm..."
  },
  {
    "officialId": 137,
    "start": 489.24,
    "end": 491.16,
    "text": "Komisch, was ist denn da los?"
  },
  {
    "officialId": 138,
    "start": 493.04,
    "end": 494.52,
    "text": "* fröhliche Musik *"
  },
  {
    "officialId": 139,
    "start": 495.0,
    "end": 496.72,
    "text": "Na warte, dich kriege ich."
  },
  {
    "officialId": 140,
    "start": 497.24,
    "end": 498.72,
    "text": "Fang mich doch."
  },
  {
    "officialId": 141,
    "start": 499.04,
    "end": 500.52,
    "text": "* Lachen *"
  },
  {
    "officialId": 142,
    "start": 502.52,
    "end": 504.0,
    "text": "Oh, du Frechdachs."
  },
  {
    "officialId": 143,
    "start": 504.6,
    "end": 506.08,
    "text": "Na warte. * Lachen *"
  },
  {
    "officialId": 144,
    "start": 508.52,
    "end": 510.96,
    "text": "Meine ist schon leer. Da, bitte schön."
  },
  {
    "officialId": 145,
    "start": 511.12,
    "end": 514.0,
    "text": "Danke. - Und jetzt noch die... Hä?"
  },
  {
    "officialId": 146,
    "start": 514.92,
    "end": 516.6,
    "text": "Gibt es Kaugummipflanzen?"
  },
  {
    "officialId": 147,
    "start": 517.2,
    "end": 520.32,
    "text": "Hm? - Das riecht genau wie meine Lieblingssorte."
  },
  {
    "officialId": 148,
    "start": 520.92,
    "end": 522.92,
    "text": "Ach ja? Lass mal sehen."
  },
  {
    "officialId": 149,
    "start": 526.16,
    "end": 527.64,
    "text": "Probier doch auch mal."
  },
  {
    "officialId": 150,
    "start": 530.52,
    "end": 532.32,
    "text": "Ha, Pfefferminze."
  },
  {
    "officialId": 151,
    "start": 532.76,
    "end": 535.16,
    "text": "Meine Kaugummis mag ich aber lieber."
  },
  {
    "officialId": 152,
    "start": 536.28,
    "end": 538.48,
    "text": "Wir können Tee aus den Blättern kochen"
  },
  {
    "officialId": 153,
    "start": 538.56,
    "end": 541.44,
    "text": "und Honig und Zitrone dazu tun. - Oh ja."
  },
  {
    "officialId": 154,
    "start": 542.72,
    "end": 545.2,
    "text": "Die Minze pflanzen wir in diese Töpfe"
  },
  {
    "officialId": 155,
    "start": 545.32,
    "end": 548.6,
    "text": "und stellen sie dahinten in den Schatten. - Dahin?"
  },
  {
    "officialId": 156,
    "start": 549.52,
    "end": 551.72,
    "text": "In Töpfen? Wieso das denn?"
  },
  {
    "officialId": 157,
    "start": 552.76,
    "end": 555.48,
    "text": "Minze mag nicht so viel Sonne wie Tomaten."
  },
  {
    "officialId": 158,
    "start": 556.08,
    "end": 560.08,
    "text": "Und die Wurzeln werden ganz lang und bilden viele neue Pflanzen,"
  },
  {
    "officialId": 159,
    "start": 560.16,
    "end": 563.84,
    "text": "dann wächst im Beet irgendwann nur noch Minze. - Ach so."
  },
  {
    "officialId": 160,
    "start": 566.36,
    "end": 567.84,
    "text": "So."
  },
  {
    "officialId": 161,
    "start": 569.64,
    "end": 572.24,
    "text": "Wann werden aus den Blüten denn Tomaten?"
  },
  {
    "officialId": 162,
    "start": 572.6,
    "end": 576.08,
    "text": "Na, das wird noch ein paar Wochen dauern. - So lange?"
  },
  {
    "officialId": 163,
    "start": 576.76,
    "end": 580.16,
    "text": "Oh... - M-hm. Nur die erntet schon vor uns."
  },
  {
    "officialId": 164,
    "start": 581.44,
    "end": 584.12,
    "text": "Oh, isst die unseren Salat auf?"
  },
  {
    "officialId": 165,
    "start": 584.56,
    "end": 586.84,
    "text": "Ja, wenn wir sie da sitzen lassen."
  },
  {
    "officialId": 166,
    "start": 587.76,
    "end": 589.24,
    "text": "Komm her, Schnecke."
  },
  {
    "officialId": 167,
    "start": 591.64,
    "end": 593.56,
    "text": "Guck mal, sie versteckt sich."
  },
  {
    "officialId": 168,
    "start": 595.84,
    "end": 597.64,
    "text": "Im Gegensatz zu Regenwürmern"
  },
  {
    "officialId": 169,
    "start": 597.72,
    "end": 599.88,
    "text": "sind Schnecken schädlich für den Garten."
  },
  {
    "officialId": 170,
    "start": 599.96,
    "end": 601.84,
    "text": "Sie fressen alle Blätter an."
  },
  {
    "officialId": 171,
    "start": 602.56,
    "end": 604.6,
    "text": "Sie kann was von meinem Salat haben."
  },
  {
    "officialId": 172,
    "start": 604.68,
    "end": 607.52,
    "text": "Aber sie wird auch Mamas und meinen Salat auffressen"
  },
  {
    "officialId": 173,
    "start": 607.6,
    "end": 610.08,
    "text": "und all die anderen Pflanzen, die hier wachsen."
  },
  {
    "officialId": 174,
    "start": 610.16,
    "end": 613.04,
    "text": "Dann bring ich sie woanders hin. - Okay, hier,"
  },
  {
    "officialId": 175,
    "start": 613.12,
    "end": 616.6,
    "text": "ein bisschen Reiseproviant für die Schnecke. - Danke."
  },
  {
    "officialId": 176,
    "start": 619.24,
    "end": 620.72,
    "text": "* ruhige Musik *"
  },
  {
    "officialId": 177,
    "start": 625.6,
    "end": 629.52,
    "text": "Schade, dass wir so lange warten müssen, bis alles reif ist."
  },
  {
    "officialId": 178,
    "start": 630.4,
    "end": 633.28,
    "text": "So, Schnecke, hier kannst du weiterkriechen."
  },
  {
    "officialId": 179,
    "start": 635.2,
    "end": 637.08,
    "text": "Papa, Papa, komm mal."
  },
  {
    "officialId": 180,
    "start": 638.8,
    "end": 641.6,
    "text": "Oh ja, da kannst du ja doch schon was ernten. - Ja?"
  },
  {
    "officialId": 181,
    "start": 641.68,
    "end": 643.36,
    "text": "Das sind wilde Erdbeeren."
  },
  {
    "officialId": 182,
    "start": 644.72,
    "end": 646.2,
    "text": "Oh, lecker."
  },
  {
    "officialId": 183,
    "start": 646.56,
    "end": 648.04,
    "text": "Ganz süß."
  },
  {
    "officialId": 184,
    "start": 648.36,
    "end": 651.04,
    "text": "Wieso wachsen die denn nicht beim Gemüse?"
  },
  {
    "officialId": 185,
    "start": 651.12,
    "end": 654.76,
    "text": "Tja, die sind wohl genau wie die Sonnenblumen hierhergekommen."
  },
  {
    "officialId": 186,
    "start": 654.84,
    "end": 656.52,
    "text": "Mit Tieren oder dem Wind."
  },
  {
    "officialId": 187,
    "start": 658.2,
    "end": 660.48,
    "text": "Gut, wenn man nicht alles so sauber hat,"
  },
  {
    "officialId": 188,
    "start": 660.56,
    "end": 662.8,
    "text": "dann wächst manches einfach von selbst."
  },
  {
    "officialId": 189,
    "start": 662.88,
    "end": 667.16,
    "text": "Weißt du was? Das nächste Mal helf ich dir beim Ernten unserer Pflanzen."
  },
  {
    "officialId": 190,
    "start": 667.88,
    "end": 669.68,
    "text": "Ja, das ist eine gute Idee."
  },
  {
    "officialId": 191,
    "start": 679.44,
    "end": 681.72,
    "text": "Untertitel im Auftrag des ZDF, 2025"
  }
]