[
  {
    "cueId": 2000101,
    "officialSubtitleIds": [
      10
    ],
    "text": "Komm, Mau, wir gucken mal, was Papa macht.",
    "start": 45.4,
    "end": 48.12
  },
  {
    "cueId": 2000102,
    "officialSubtitleIds": [
      11
    ],
    "text": "Siehst du, da ist er.",
    "start": 48.2,
    "end": 49.68
  },
  {
    "cueId": 2000103,
    "officialSubtitleIds": [
      12
    ],
    "text": "Hey, Mau, wo willst du denn hin?",
    "start": 51.12,
    "end": 53.24
  },
  {
    "cueId": 2000104,
    "officialSubtitleIds": [
      15
    ],
    "text": "Was ist das?",
    "start": 62.6,
    "end": 64.08
  },
  {
    "cueId": 2000105,
    "officialSubtitleIds": [
      20
    ],
    "text": "Wenn du magst, kannst du die Pflanzen schon mal zu dem Beet tragen.",
    "start": 75.48,
    "end": 79.88
  },
  {
    "cueId": 2000106,
    "officialSubtitleIds": [
      21,
      22
    ],
    "text": "Aber nicht alle Blumen abmähen. Die sind doch so schön.",
    "start": 80.84,
    "end": 84.72
  },
  {
    "cueId": 2000107,
    "officialSubtitleIds": [
      23
    ],
    "text": "Ja ja, ich mäh drumherum.",
    "start": 85.16,
    "end": 87.03999999999999
  },
  {
    "cueId": 2000108,
    "officialSubtitleIds": [
      28
    ],
    "text": "Hä? Was machst du damit?",
    "start": 99.44,
    "end": 101.72
  },
  {
    "cueId": 2000109,
    "officialSubtitleIds": [
      29
    ],
    "text": "Das kommt auf den Kompost.",
    "start": 102.88,
    "end": 104.6
  },
  {
    "cueId": 2000110,
    "officialSubtitleIds": [
      31
    ],
    "text": "Ich will das machen, ja?",
    "start": 107.84,
    "end": 109.44
  },
  {
    "cueId": 2000111,
    "officialSubtitleIds": [
      38
    ],
    "text": "Zum Pflanzen brauchen wir einen Spaten.",
    "start": 132.48,
    "end": 135.0
  },
  {
    "cueId": 2000112,
    "officialSubtitleIds": [
      39
    ],
    "text": "Huh, der ist aber richtig schwer.",
    "start": 135.52,
    "end": 137.72
  },
  {
    "cueId": 2000113,
    "officialSubtitleIds": [
      42
    ],
    "text": "Wozu brauchen wir die?",
    "start": 147.07999999999998,
    "end": 148.56
  },
  {
    "cueId": 2000114,
    "officialSubtitleIds": [
      43
    ],
    "text": "Damit lockern wir die Erde auf.",
    "start": 151.8,
    "end": 153.88
  },
  {
    "cueId": 2000115,
    "officialSubtitleIds": [
      52
    ],
    "text": "Was ist denn, Papa?",
    "start": 178.36,
    "end": 179.84
  },
  {
    "cueId": 2000116,
    "officialSubtitleIds": [
      53
    ],
    "text": "Ich überlege, wo welche Pflanze am besten hinkommt.",
    "start": 181.04,
    "end": 184.0
  },
  {
    "cueId": 2000117,
    "officialSubtitleIds": [
      57
    ],
    "text": "Na ja, die wollen alle viel Sonne, damit sie schön wachsen können.",
    "start": 192.48,
    "end": 196.12
  },
  {
    "cueId": 2000118,
    "officialSubtitleIds": [
      58
    ],
    "text": "Ähm... ich will auch in der Sonne stehen.",
    "start": 196.2,
    "end": 199.4
  },
  {
    "cueId": 2000119,
    "officialSubtitleIds": [
      66
    ],
    "text": "Hm? Was ist denn Unkraut?",
    "start": 222.12,
    "end": 224.04
  },
  {
    "cueId": 2000120,
    "officialSubtitleIds": [
      68
    ],
    "text": "Das haben wir nämlich gar nicht gepflanzt.",
    "start": 227.07999999999998,
    "end": 229.8
  },
  {
    "cueId": 2000121,
    "officialSubtitleIds": [
      71
    ],
    "text": "He, Mau, Vorsicht, ich muss doch hier hacken.",
    "start": 242.84,
    "end": 245.76
  },
  {
    "cueId": 2000122,
    "officialSubtitleIds": [
      75
    ],
    "text": "Huch, wer bist du denn?",
    "start": 260.44,
    "end": 261.96
  },
  {
    "cueId": 2000123,
    "officialSubtitleIds": [
      76
    ],
    "text": "Na, habt ihr was Spannendes entdeckt?",
    "start": 263.0,
    "end": 265.4
  },
  {
    "cueId": 2000124,
    "officialSubtitleIds": [
      78
    ],
    "text": "Die sind sehr nützlich.",
    "start": 267.92,
    "end": 269.44
  },
  {
    "cueId": 2000125,
    "officialSubtitleIds": [
      79
    ],
    "text": "Der kribbelt in der Hand.",
    "start": 270.52,
    "end": 272.72
  },
  {
    "cueId": 2000126,
    "officialSubtitleIds": [
      88
    ],
    "text": "Die haben doch so wunderschöne Blüten.",
    "start": 309.88,
    "end": 312.36
  },
  {
    "cueId": 2000127,
    "officialSubtitleIds": [
      102
    ],
    "text": "Ich denke, hier ist der richtige Platz für die Tomaten.",
    "start": 357.56,
    "end": 361.16
  },
  {
    "cueId": 2000128,
    "officialSubtitleIds": [
      103
    ],
    "text": "Hm, Tomaten mag ich am liebsten.",
    "start": 361.96,
    "end": 365.24
  },
  {
    "cueId": 2000129,
    "officialSubtitleIds": [
      104
    ],
    "text": "Hm, die riechen jetzt schon nach Tomaten. Hä?",
    "start": 366.84,
    "end": 369.76
  },
  {
    "cueId": 2000130,
    "officialSubtitleIds": [
      107
    ],
    "text": "Da riechen die Blätter wie später die Früchte.",
    "start": 377.88,
    "end": 380.52
  },
  {
    "cueId": 2000131,
    "officialSubtitleIds": [
      108
    ],
    "text": "Hier, aus den Blüten werden später die Tomaten.",
    "start": 380.6,
    "end": 383.68
  },
  {
    "cueId": 2000132,
    "officialSubtitleIds": [
      110
    ],
    "text": "Die klemmt irgendwie.",
    "start": 389.8,
    "end": 391.28
  },
  {
    "cueId": 2000133,
    "officialSubtitleIds": [
      112
    ],
    "text": "Am besten, du drückst den Topf an allen Seiten ein bisschen ein.",
    "start": 394.92,
    "end": 399.12
  },
  {
    "cueId": 2000134,
    "officialSubtitleIds": [
      113
    ],
    "text": "Vielleicht so?",
    "start": 400.44,
    "end": 401.92
  },
  {
    "cueId": 2000135,
    "officialSubtitleIds": [
      119
    ],
    "text": "Mit den Wurzeln hält die Pflanze sich fest.",
    "start": 419.6,
    "end": 422.2
  },
  {
    "cueId": 2000136,
    "officialSubtitleIds": [
      120
    ],
    "text": "Die Wurzel saugt auch Wasser aus der Erde, damit die Pflanze trinken kann.",
    "start": 422.28,
    "end": 427.12
  },
  {
    "cueId": 2000137,
    "officialSubtitleIds": [
      134
    ],
    "text": "Das tun sie bestimmt, wenn wir sie gut gießen.",
    "start": 477.0,
    "end": 479.48
  },
  {
    "cueId": 2000138,
    "officialSubtitleIds": [
      135
    ],
    "text": "Ich hole eine Gießkanne.",
    "start": 479.56,
    "end": 481.16
  },
  {
    "cueId": 2000139,
    "officialSubtitleIds": [
      137
    ],
    "text": "Komisch, was ist denn da los?",
    "start": 489.24,
    "end": 491.16
  },
  {
    "cueId": 2000140,
    "officialSubtitleIds": [
      140
    ],
    "text": "Fang mich doch.",
    "start": 497.24,
    "end": 498.72
  },
  {
    "cueId": 2000141,
    "officialSubtitleIds": [
      149
    ],
    "text": "Probier doch auch mal.",
    "start": 526.16,
    "end": 527.64
  },
  {
    "cueId": 2000142,
    "officialSubtitleIds": [
      157
    ],
    "text": "Minze mag nicht so viel Sonne wie Tomaten.",
    "start": 552.76,
    "end": 555.48
  },
  {
    "cueId": 2000143,
    "officialSubtitleIds": [
      161
    ],
    "text": "Wann werden aus den Blüten denn Tomaten?",
    "start": 569.64,
    "end": 572.24
  },
  {
    "cueId": 2000144,
    "officialSubtitleIds": [
      164
    ],
    "text": "Oh, isst die unseren Salat auf?",
    "start": 581.44,
    "end": 584.12
  },
  {
    "cueId": 2000145,
    "officialSubtitleIds": [
      166
    ],
    "text": "Komm her, Schnecke.",
    "start": 587.76,
    "end": 589.24
  },
  {
    "cueId": 2000146,
    "officialSubtitleIds": [
      167
    ],
    "text": "Guck mal, sie versteckt sich.",
    "start": 591.64,
    "end": 593.56
  },
  {
    "cueId": 2000147,
    "officialSubtitleIds": [
      171
    ],
    "text": "Sie kann was von meinem Salat haben.",
    "start": 602.56,
    "end": 604.6
  },
  {
    "cueId": 2000148,
    "officialSubtitleIds": [
      177
    ],
    "text": "Schade, dass wir so lange warten müssen, bis alles reif ist.",
    "start": 625.6,
    "end": 629.52
  },
  {
    "cueId": 2000149,
    "officialSubtitleIds": [
      181
    ],
    "text": "Das sind wilde Erdbeeren.",
    "start": 641.68,
    "end": 643.36
  },
  {
    "cueId": 2000150,
    "officialSubtitleIds": [
      184
    ],
    "text": "Wieso wachsen die denn nicht beim Gemüse?",
    "start": 648.36,
    "end": 651.04
  },
  {
    "cueId": 2000151,
    "officialSubtitleIds": [
      189
    ],
    "text": "Weißt du was? Das nächste Mal helf ich dir beim Ernten unserer Pflanzen.",
    "start": 662.88,
    "end": 667.16
  },
  {
    "cueId": 2000152,
    "officialSubtitleIds": [
      190
    ],
    "text": "Ja, das ist eine gute Idee.",
    "start": 667.88,
    "end": 669.68
  }
]